# FailWatch 环境变量示例
# 复制本文件为 .env 后填写实际值；.env 已被 gitignore，本文件进版本库作为模板。

# 数据库连接（必填；懒加载：首次查询才连，CI 无此值也能跑测试）
DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# CORS 允许来源白名单（逗号分隔；留空 = '*'，本地多端口 demo 零配置；上线前设具体域名）
ALLOWED_ORIGINS=

# 写入鉴权（可选；留空 = 放行，本地 demo 零配置；上线前设强随机值，SDK 需带 Bearer 上报）
INGEST_API_KEY=

# DeepSeek API Key（AI 报告用；留空走 mock）
DEEPSEEK_API_KEY=

# LLM 模式：deepseek | mock（默认 mock）
LLM_MODE=mock

# 样例落盘文件（AI 学习用，留空用默认路径）
LLM_SAMPLES_FILE=
