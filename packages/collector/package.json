{
  "name": "@failwatch/collector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "start:deepseek": "LLM_MODE=deepseek tsx --env-file=../../.env src/index.ts",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "seed:watch": "tsx --env-file=../../.env src/seed.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@failwatch/sdk": "workspace:*",
    "express": "^4.21.0",
    "postgres": "^3.4.9",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
